class Solution(object):
    def numRescueBoats(self, people, limit):
        people.sort()
        count = 0
        i = 0
        j = len(people) -1

        while i <= j:
            if people[i] + people[j] <= limit:
                count += 1
                i += 1
                j -=1
            elif people[i] + people[j] > limit:
                count += 1
                j -= 1
        return count



        
