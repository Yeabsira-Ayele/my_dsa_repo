class Solution(object):
    def smallerNumbersThanCurrent(self, nums):
        n = len(nums)
        count = []
        for i in range(n): 
            add = 0
            for j in range(n): 
                if i != j and nums[j] < nums[i]:

                    add+=1
            count.append(add)
        return count
  #  time c  on * on = O(n2)
  # space c on + o1 = O(n)
        
