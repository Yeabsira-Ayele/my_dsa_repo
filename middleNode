# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def middleNode(self, head):
        
        size = 0
        cur = head

        while cur:
            size += 1
            cur = cur.next
            

        middle = size // 2 

        cur = head
        while middle  > 0:
            head = cur.next
            cur = cur.next
            middle -= 1

        return head
