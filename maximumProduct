class Solution(object):
    def maximumProduct(self, nums):
        
        nums.sort() # 0(n)

        l = 0
        r = len(nums) - 1

        ans1 = nums[0] * nums[r] * nums[r-1]
        ans2 =  nums[0] * nums[r] * nums[l+1]
        ans3 =  nums[r] * nums[r - 1] * nums[r - 2]

        if ans1 > ans2 and ans1 > ans3:
            return ans1
        elif ans2 > ans1 and ans2 > ans3:
            return ans2
        else:
            return ans3

