class Solution(object):
    def characterReplacement(self, s, k):
        w = 0
        l =0
       
        counts = [0] * 26
        n = len(s)

        for r in range(n):

            counts[ord(s[r]) - 65] +=1
            h = k

            while (r -l +1) - max(counts) > k:
                counts[ord(s[l]) -65] -= 1
                l +=1

            w = max(w , r-l+1)
        
        return w









