class Solution(object):
    def canPlaceFlowers(self, flowerbed, n):
       
        len_f= len(flowerbed) 
        c=0
        
    
        if len_f == 2:
            if flowerbed[0] == flowerbed[1] == 0:
                return n < 2
        
        elif len_f == 1:
            if flowerbed[0] == 0:
                return n < 2
        
        elif len_f > 2:
            if flowerbed[0] == flowerbed[1] == 0:
                flowerbed[0] = 1
                c += 1

            for i in range(1 , len_f-1 ):
                if flowerbed[i] == flowerbed[i-1] ==flowerbed[i+1] == 0:
                    flowerbed[i]= 1
                    c+=1

            if flowerbed[len_f-2] == flowerbed[len_f-1] == 0:
                flowerbed[len_f -1] = 1
                c+= 1
        return c >= n
        # time o(n) 
        # space o(1)



        
        
