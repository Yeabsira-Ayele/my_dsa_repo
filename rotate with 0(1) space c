class Solution(object):
    def rotate(self, nums, k):
        n = len(nums) 
        ans = []
        k = k % n
        i = n-k

        for j in range(i , n):
            ans.append(nums[j])
        
        for j in range(0 , i):
            ans.append(nums[j])
            
        nums[:] = ans  
# time o(n) space 0(n)

# beter with 01 space c 

class Solution(object):
    def rotate(self, nums, k):
        n = len(nums) 

        if n == 0:
            return

        k %= n

        f=0
        b=n-1

        while f < b:
            nums[f] , nums[b] = nums[b] , nums[f]
            f+=1
            b-=1
        f=0
        b=k-1
        while f < b:
            nums[f] , nums[b] = nums[b] , nums[f]
            f+=1
            b-=1
        
        f=k
        b=n-1
        while f < b:
            nums[f] , nums[b] = nums[b] , nums[f]
            f+=1
            b-=1

      
            
        return nums

            
       
