class Solution(object):
    def minSubArrayLen(self, target, nums):
        min_length = float('inf')
        n = len(nums)

        w = 0
        r = 0
        l = 0

        while r < n:
            w += nums[r]

            while w >= target:
                min_length = min(r - l + 1, min_length)
                w -= nums[l]
                l += 1

            r += 1

        return 0 if min_length == float('inf') else min_length
