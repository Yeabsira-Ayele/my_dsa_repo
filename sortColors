class Solution(object):
    def sortColors(self, nums):
        for i in range(len(nums)):

            swapped = False
            for j in range(len(nums) -i -1):
                if nums[j] > nums[j + 1]:
                    swapped = True
                    nums[j] , nums[j + 1] = nums[j + 1] , nums[j ]
        return nums






