class Solution(object):
    def removeDuplicates(self, nums):
        u = 1
        c = 0
        n = len(nums)

        for c in range(1 , n):
            if nums[c-1] == nums[c]:
                continue
            nums[u] = nums[c]
            u += 1
            
        nums[:] = nums[:u]
