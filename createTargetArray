class Solution(object):
    def createTargetArray(self, nums, index):
        """
        :type nums: List[int]
        :type index: List[int]
        :rtype: List[int]
        """
        
        n = len(index)
        target =[]

        for i in range(n):
           
            target.insert(index[i] , nums[i])
                 
        return target
