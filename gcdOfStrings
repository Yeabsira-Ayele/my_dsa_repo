
class Solution(object):
    def gcdOfStrings(self, str1, str2):
        t = len(str1)
        r = len(str2)
        a = t
        b =r

        # GCF
        while b != 0:
            a, b = b, a % b

        char = str1[:a]
        chart = ""
        charr = ""
        ans1 = False
        ans2 = False
        for i in range(t // a):
            chart += char

            if chart == str1 and i + 1 == t // a:
                ans1 = True

        for i in range(r // a):
            charr += char

            if charr == str2 and i + 1 == r // a:
                ans2 = True

        if ans1 == ans2 == True:
            return char

        return ""

