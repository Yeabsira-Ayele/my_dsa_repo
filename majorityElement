class Solution(object):
    def majorityElement(self, nums):
        n = len(nums)
        nums.sort()

        res = []
        count = 1

        for i in range(1, n):
            if nums[i] == nums[i - 1]:
                count += 1
            else:
                if count > n // 3:
                    res.append(nums[i - 1])
                count = 1

        # Check the last group
        if count > n // 3:
            res.append(nums[-1])

        return res
