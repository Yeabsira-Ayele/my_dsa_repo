class Solution(object):
    def checkInclusion(self, s1, s2):

        dict1 = {}
        dict2 = {}

        l = 0
        n = len(s2)
        m = len(s1)
        r = m

        if m > n :
            return False

        
        for s in s1:
            if s not in dict1:
                dict1[s] = 1
            else:
                dict1[s] += 1
        
        for t in range(m):
            if s2[t] not in dict2:
                dict2[s2[t]] = 1
            else:
                dict2[s2[t]] += 1
        
        if dict1 == dict2 :
            return True
        
        

        for r in range(m , n):
            if s2[r] not in dict2:
                dict2[s2[r]] = 1
            else:
                dict2[s2[r]] += 1
            
            dict2[s2[l]] -= 1

            if dict2[s2[l]] == 0:
                del dict2[s2[l]]
                
            l+=1

           
            if dict1 == dict2 :
                return True
        return False
            


      

        
