class Solution(object):
    def targetIndices(self, nums, target):
        res = []
        nums.sort()
        for i in range(len(nums)):
            if nums[i] == target:
                res.append(i)
            elif nums[i] > target:
                break
            else:
                continue
            
        return res
# time O(N)+ O(nlogn)
# space o(n)
        
