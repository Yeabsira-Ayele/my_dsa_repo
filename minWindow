
class Solution(object):
    def minWindow(self, s, t):
        dict1 = {}
        dict2 = {}

        l = 0
        w = float('inf')
        start = 0

        n = len(s)
        m = len(t)

        if m > n:
            return ""

        # Build the required character frequency dictionary
        for i in range(m):
            if t[i] in dict1:
                dict1[t[i]] += 1
            else:
                dict1[t[i]] = 1

        # Expand the window using r
        for r in range(n):

            if s[r] in dict2:
                dict2[s[r]] += 1
            else:
                dict2[s[r]] = 1

            # Shrink while the current window is valid
            while all(dict2.get(char, 0) >= frequency
                      for char, frequency in dict1.items()):

                # Calculate current window length
                current_length = r - l + 1

                # Save the smallest valid window
                if current_length < w:
                    w = current_length
                    start = l

                # Remove the leftmost character
                dict2[s[l]] -= 1

                if dict2[s[l]] == 0:
                    del dict2[s[l]]

                l += 1

        # Return the result
        if w == float('inf'):
            return ""

        return s[start:start + w]
